<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds trust the system's certificate authorities only (a BitVoice reached from anywhere has a
     real certificate, from Let's Encrypt say). Debug builds also trust certificates the device's owner
     installed, so a test server's own certificate can be used. -->
<network-security-config>
    <base-config>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
